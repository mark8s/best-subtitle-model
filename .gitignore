# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# 临时目录 / 离线 pip 包（体积大，不提交）
tmp*/
.tmp/
wheels/
*.whl

# 运行输出（保留目录占位）
output/*
!output/.gitkeep

# 测试输入：字幕/音视频都不提交（只留示例 srt）
input/*
!input/.gitkeep
!input/sample.srt

# 常见媒体（防漏网）
*.wav
*.mp3
*.m4a
*.flac
*.aac
*.ogg
*.wma
*.mp4
*.mkv
*.webm
*.mov
*.avi

# 模型全部不进 git（只保留说明）
models/*
!models/README.md
!models/.gitkeep
